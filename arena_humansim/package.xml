<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>arena_humansim</name>
  <version>0.0.0</version>
  <description>Arena human simulator: modular, deterministic pedestrian simulation</description>
  <maintainer email="dev@voshch.dev">voshch</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>arena_humansim_msgs</depend>
  <exec_depend>arena_humansim_viz</exec_depend>
  <exec_depend>python3-attr</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-pyarrow</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-pytest-xdist</test_depend>
  <test_depend>python3-hypothesis</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
